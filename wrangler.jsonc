{
  "name": "ai-toolbox",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-toolbox-content",
      "database_id": "a8115f5c-cdcb-439b-9a7d-b3961b7ca626"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "ai-toolbox-assets"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "ai-toolbox-batch",
        "binding": "BATCH_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "ai-toolbox-batch",
        "max_batch_size": 2,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  },
  "browser": {
    "binding": "BROWSER"
  }
}